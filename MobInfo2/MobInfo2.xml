<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/">
	<Script file="localization.lua"/> 
	<Script file="localization.de.lua"/> 
	<Script file="localization.fr.lua"/> 
	<Script file="localization.es.lua"/> 
	<Script file="localization.tw.lua"/> 
	<Script file="localization.cn.lua"/> 
	<Script file="localization.ko.lua"/> 
	<Script file="MobInfo2.lua" /> 
	<Script file="MI2_Import.lua" /> 
	<Script file="MI2_Events.lua" /> 
	<Script file="MI2_Health.lua" /> 
	<Script file="MI2_Slash.lua" /> 
	<Script file="MI2_Search.lua" /> 
	<Script file="MI2_pfUI.lua" /> 
	
	<Frame name="MI2_MobInfoFrame">
		<Scripts>	
			<OnLoad>
				if C_Item then MI2_OnLoad() end
			</OnLoad>   
			<OnEvent>
				if C_Item then MI2_OnEvent(event) end
			</OnEvent> 
		</Scripts>
	</Frame>

	<!-- Hidden tooltip frame used to warm the item cache for uncached items.
		 SetHyperlink on a GameTooltip forces the engine to fetch item data
		 from the server, populating the cache far faster than RequestLoadItemDataByID. -->
	<GameTooltip name="MI2_ItemCacheTooltip" parent="UIParent" hidden="true">
	</GameTooltip>

	<Frame name="MI2_MobHealthFrame" toplevel="true" frameStrata="LOW" movable="true" enableMouse="true" parent="TargetFrame">
		<Size>     <AbsDimension x="128" y="32"/>  </Size>
		<Anchors>  <Anchor point="TOP"/>           </Anchors>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="MI2_MobHealthText" inherits="GameFontNormalSmall">
					<Anchors>  <Anchor point="TOP"/>  </Anchors>
					<Color r="1.0" g="1.0" b="1.0"/>
				</FontString>
				<FontString name="MI2_MobManaText" inherits="GameFontNormalSmall">
					<Anchors>  <Anchor point="TOP"/>  </Anchors>
					<Color r="1.0" g="1.0" b="1.0"/>
				</FontString>
			</Layer>
		</Layers>
	</Frame>
</Ui>
